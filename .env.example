# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Values are quoted so this file stays `source`-able from bash. Angle-bracket
# placeholders break shell parsing (`<` is a redirect) - learned the hard way.

# --- Razorpay TEST MODE credentials ---
# Dashboard > Settings > API Keys (make sure the Test/Live toggle is on TEST).
# Test keys start with rzp_test_. A live key here is a mistake, not a shortcut.
RAZORPAY_KEY_ID="rzp_test_REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_ME"

# --- LLM (explanation prose only; no number on screen comes from a model) ---
# Any OpenAI-compatible endpoint. Default is Groq serving GPT-OSS (Apache 2.0,
# open weights). Leave the key empty and the engine uses its deterministic
# templates instead - the verdict screen renders either way.
#
# Key: https://console.groq.com/keys
FINCTL_LLM_API_KEY=""
FINCTL_LLM_BASE_URL="https://api.groq.com/openai/v1"
FINCTL_LLM_MODEL="openai/gpt-oss-20b"

# GPT-OSS is a REASONING model: at the default effort it spends its whole token
# budget on hidden reasoning and returns empty content. Low effort is both correct
# and cheaper for prose over facts that are already resolved.
FINCTL_LLM_REASONING_EFFORT="low"
FINCTL_LLM_TIMEOUT_SECONDS="8"

# Read as a fallback so an existing GROQ_API_KEY in your shell just works.
GROQ_API_KEY=""

# --- Engine ---
# Seed for the synthetic data generator. Fixed by default so runs are reproducible
# and the metrics table can be regenerated exactly.
FINCTL_SEED=20260902
FINCTL_DATA_DIR=./data
FINCTL_AUDIT_DIR=./audit

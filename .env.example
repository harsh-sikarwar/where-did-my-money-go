# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Razorpay TEST MODE credentials ---
# Dashboard > Settings > API Keys (make sure the Test/Live toggle is on TEST).
# Test keys start with rzp_test_. A live key here is a mistake, not a shortcut.
RAZORPAY_KEY_ID=rzp_test_<your-test-key-id>
RAZORPAY_KEY_SECRET=<your-test-key-secret>

# --- LLM (explanation layer only; the engine never calls this) ---
ANTHROPIC_API_KEY=<your-anthropic-api-key>
FINCTL_LLM_MODEL=claude-sonnet-5

# --- Engine ---
# Seed for the synthetic data generator. Fixed by default so runs are reproducible
# and the metrics table can be regenerated exactly.
FINCTL_SEED=20260902
FINCTL_DATA_DIR=./data
FINCTL_AUDIT_DIR=./audit

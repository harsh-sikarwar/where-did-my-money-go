# --- Generated data & runtime output ---
# Batches are regenerated from a seed; the seed is the source of truth, not the CSVs.
# Generated batches, anywhere in the tree — `data/*` alone only matches the root.
# Batches are reproducible from a seed, so the seed is the artefact worth keeping,
# not several megabytes of CSV.
/data/*
!/data/.gitkeep
engine/data/
# Blind-test batches and their answer keys. Never committed: a committed answer
# key is not an answer key.
data/blind/
finctl-answers/
*.sqlite
*.sqlite3
*.db
audit/*.jsonl

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
